{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch --import ./src/server/sentry.server.ts src/server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --import ./dist/server/sentry.server.js dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/schedule": "^6.0.0",
    "@fastify/static": "^8.3.0",
    "@openfeature/core": "^1.12.0",
    "@openfeature/env-var-provider": "^0.3.1",
    "@openfeature/ofrep-provider": "^0.2.5",
    "@openfeature/server-sdk": "^1.23.0",
    "@sentry/node": "^10.69.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "ioredis": "^5.11.1",
    "mime-types": "^3.0.2",
    "pdfjs-viewer-element": "^3.2.2",
    "toad-scheduler": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/work-sans": "^5.3.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.4",
    "highlight.js": "^11.11.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
